APP_NAME=Recollect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# docker-compose.yml の db コンテナに接続する(DB_HOST はサービス名)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=quiz
DB_USERNAME=quiz
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# 管理者アカウント(config/quiz.php)。Seeder がこの値でログインユーザーを作る。
# 下の値はローカル開発用。本番では必ず別の値にする(開発用のパスワードのままだと Seeder がエラーで止まる)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

# アプリ固有の設定(config/quiz.php)。コメントアウトしたままなら既定値を使う
# QUIZ_MAX_QUESTIONS_PER_SECTION=10
# QUIZ_ANSWER_RETENTION_LIMIT=10
# QUIZ_WEAK_THRESHOLD=60
# QUIZ_DISPLAY_TIMEZONE=Asia/Tokyo

# Claude API の単価(ドル)。Anthropic の公式料金表の値を設定する。未設定ならコストは表示しない
# QUIZ_PRICE_INPUT_PER_MTOK=
# QUIZ_PRICE_OUTPUT_PER_MTOK=
# QUIZ_PRICE_WEB_SEARCH=

# AI 採点(config/services.php)。fake: Claude API を呼ばない決まった採点 / claude: 本物の採点
# 画面の作り込みとテストは fake で行う。本番では claude にする
GRADING_DRIVER=fake

# Claude API(GRADING_DRIVER=claude のときに使う)。キーは Anthropic Console で発行する。リポジトリには絶対に入れない
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
